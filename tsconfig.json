{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@sheldon/core": ["./packages/core/src/index.ts"],
      "@sheldon/vault": ["./packages/vault/src/index.ts"],
      "@sheldon/persistence": ["./packages/persistence/src/index.ts"],
      "@sheldon/plugin-sdk": ["./packages/plugin-sdk/src/index.ts"],
      "@sheldon/plugin-host": ["./packages/plugin-host/src/index.ts"],
      "@sheldon/ingestion": ["./packages/ingestion/src/index.ts"],
      "@sheldon/agent-runtime": ["./packages/agent-runtime/src/index.ts"],
      "@sheldon/review": ["./packages/review/src/index.ts"],
      "@sheldon/plugin-file": ["./packages/plugins/official/sheldon.file/src/index.ts"],
      "@sheldon/cli": ["./apps/cli/src/main.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "types/**/*.d.ts"]
}
