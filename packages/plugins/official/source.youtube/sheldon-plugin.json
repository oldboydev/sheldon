{
  "schemaVersion": 1,
  "id": "source.youtube",
  "name": "Official YouTube ingestion",
  "version": "1.0.0",
  "protocolVersion": "1",
  "license": "MIT",
  "command": { "executable": "node", "arguments": ["plugin.mjs"] },
  "capabilities": ["ingest-url"],
  "priority": 200,
  "platforms": ["win32", "darwin", "linux"],
  "permissions": { "network": true, "cookies": false },
  "dependencies": [
    {
      "id": "yt-dlp",
      "kind": "executable",
      "required": true,
      "remediation": "Reinstall the official source.youtube plugin for this platform."
    }
  ]
}
