{
  "name": "sheldon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "sheldon": "apps/cli/dist/sheldon.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/official/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "build": "node scripts/build.mjs",
    "build:ocr-runtime": "node scripts/release/build-ocr-runtime.mjs",
    "build:official-release": "node scripts/release/build-official-artifacts.mjs",
    "sign:official-catalog": "node scripts/release/sign-official-catalog.mjs",
    "verify:official-release": "node scripts/release/verify-official-release.mjs",
    "build:native:win32": "npm run build:native:win32 --workspace @sheldon/plugin-host",
    "sheldon": "node apps/cli/dist/sheldon.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.superpowers\" \"#.worktrees\"",
    "lint:domain": "node scripts/verify-domain.mjs",
    "verify:plugin-contract": "node scripts/verify-plugin-contract.mjs",
    "lint:repo": "node scripts/verify-change-policy.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run lint:md && npm run test && npm run coverage && npm run build && npm run verify:plugin-contract && npm run lint:domain && npm run lint:repo && git diff --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.11.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0"
  }
}
