{
  "name": "sheldon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "sheldon": "apps/cli/dist/sheldon.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "build": "node scripts/build.mjs",
    "sheldon": "node apps/cli/dist/sheldon.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:domain": "node scripts/verify-domain.mjs",
    "lint:repo": "node scripts/verify-change-policy.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run lint:md && npm run test && npm run build && npm run lint:domain && npm run lint:repo && git diff --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^24.13.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  }
}
